# Битрикс24: Разработчикам → Другое → Входящий вебхук (права: crm, task)
BITRIX_WEBHOOK_URL=https://your-portal.bitrix24.ru/rest/1/xxxxxxxxxxxx/
# Исходящий вебхук на событие ONCRMLEADADD → URL https://<host>/webhooks/bitrix, сюда его токен
BITRIX_APP_TOKEN=
BITRIX_RESPONSIBLE_ID=1

# amoCRM: amoМаркет → Создать интеграцию → долгосрочный токен
AMO_BASE_URL=https://your-subdomain.amocrm.ru
AMO_TOKEN=
# Вебхук amoCRM «Сделка добавлена» → https://<host>/webhooks/amo?secret=<AMO_WEBHOOK_SECRET>
AMO_WEBHOOK_SECRET=

MIRROR_TO_BITRIX=true
MIRROR_TO_AMO=true

# Без ключа работает квалификация по правилам
OPENROUTER_API_KEY=
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free

# Заголовок X-Form-Secret для /webhooks/form, /stats, /jobs/{id}/retry
FORM_SECRET=change-me
DB_PATH=/data/bridge.sqlite3
